msgstr "संस्थागत परिनियोजन या सेवा-आधारित मॉडलों के लिए विकसित।"

#: templates/index.html:250
msgid "Primary Users"
msgstr "प्रमुख उपयोगकर्ता"

#: templates/index.html:267
msgid "Secondary Beneficiaries"
msgstr "द्वितीयक लाभार्थी"

