#: accounts/utils/password_validators.py:18
msgid "at least one uppercase letter (A–Z)"
msgstr "कम से कम एक अपरके अंग्रेज़ी अक्षर (A–Z) होना चाहिए।"

#: accounts/utils/password_validators.py:21
msgid "at least one lowercase letter (a–z)"
msgstr "कम से कम एक छोटा अंग्रेज़ी अक्षर (a–z) होना चाहिए।"

#: accounts/utils/password_validators.py:24
msgid "at least one digit (0–9)"
msgstr "कम से कम एक अंक (0–9) होना चाहिए।"

#: accounts/utils/password_validators.py:27
msgid "at least one special character (e.g. !@#$%^&*)"
msgstr "कम से कम एक विशेष वर्ण (जैसे: !@#$%^&*) होना चाहिए।"

#: accounts/utils/password_validators.py:31
#, python-format
msgid "Your password must contain %(requirements)s."
msgstr "आपके पासवर्ड में %(requirements)s होना आवश्यक है।"

#: accounts/utils/password_validators.py:38
msgid ""
"Your password must contain at least one uppercase letter, one lowercase letter, one digit, and "
"one special character."
msgstr ""
"आपके पासवर्ड में कम से कम एक बड़ा अंग्रेज़ी अक्षर, एक छोटा अंग्रेज़ी अक्षर, एक अंक तथा एक विशेष वर्ण होना आवश्यक है।"

#: accounts/utils/password_validators.py:69
#, python-brace-format
msgid ""
"You cannot reuse any of your last {self.history_limit} passwords. Please choose a different "
"password."
msgstr ""
"आप अपने पिछले {self.history_limit} पासवर्डों में से किसी का भी पुनः उपयोग नहीं कर सकते। कृपया कोई अलग "
"पासवर्ड चुनें।"

#: accounts/utils/password_validators.py:77
#, python-brace-format
msgid "Your password must not be the same as any of your last {self.history_limit} passwords."
msgstr "आपका पासवर्ड आपके पिछले {self.history_limit} पासवर्डों में से किसी के समान नहीं होना चाहिए।"

#: accounts/views.py:37
msgid "Registration successful! Student can now login."
